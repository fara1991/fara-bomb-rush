<settings-container>

  <horizontal bg='panel-top' pad='2'>
    <text text="~header-common" font-size="4" color="#B060E0" align="Center"/>
  </horizontal>

  <dropdown-list-setting
    text="~language-text"
    options="language-options"
    value="selected-language"
    apply-on-change="true"
    hover-hint="~language-hint"
  />

  <toggle-setting
    text="~enabled-text"
    value="selected-is-enabled"
    apply-on-change="true"
    hover-hint="~enabled-hint"
  />

  <horizontal bg='panel-top' pad='2'>
    <text text="~header-bomb" font-size="4" color="#B060E0" align="Center"/>
  </horizontal>

  <dropdown-list-setting
    text="~game-mode-text"
    options="game-mode-options"
    value="selected-game-mode"
    formatter="game-mode-format"
    apply-on-change="true"
    hover-hint="~game-mode-hint"
  />

  <dropdown-list-setting
    text="~player-level-text"
    options="player-bomb-level-options"
    value="selected-player-bomb-level"
    apply-on-change="true"
    hover-hint="~player-recommend-level"
  />

  <toggle-setting
    text="~bomb-cut-text"
    value="selected-is-bomb-cut-enable"
    apply-on-change="true"
    hover-hint="~bomb-cut-hint"
  />

</settings-container>
