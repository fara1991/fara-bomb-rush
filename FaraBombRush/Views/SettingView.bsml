<settings-container>

  <horizontal bg='panel-top' pad='2'>
    <text text="Common" font-size="4" color="#B060E0" align="Center"/>
  </horizontal>

  <dropdown-list-setting
    text="Language"
    options="language-options"
    value="selected-language"
    apply-on-change="true"
    hover-hint="Choose display language"
  />

  <toggle-setting
    text="Enabled"
    value="selected-is-enabled"
    apply-on-change="true"
    hover-hint="Enable or disable Fara Bomb Rush"
  />

  <horizontal bg='panel-top' pad='2'>
    <text text="Bomb Settings" font-size="4" color="#B060E0" align="Center"/>
  </horizontal>

  <dropdown-list-setting
    text="Play Mode"
    options="game-mode-options"
    value="selected-game-mode"
    apply-on-change="true"
    hover-hint="Choose a game mode to play."
  />

  <dropdown-list-setting
    text="Player Bomb Level"
    options="player-bomb-level-options"
    value="selected-player-bomb-level"
    apply-on-change="true"
    hover-hint="~player-recommend-level"
  />

  <toggle-setting
    text="Valid Bomb Collision"
    value="selected-is-bomb-cut-enable"
    apply-on-change="true"
    hover-hint="Choose bomb collision"
  />


</settings-container>
