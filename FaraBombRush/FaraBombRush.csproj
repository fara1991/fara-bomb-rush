    <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets"/>
    <!-- Mod が実行時に UserData\FaraBombRush\farabomb.particle を読み込むので、ビルドしたゲームのバージョンの UserData に入れておく
         （1.40.8 にはこのフォルダが無く、そのままでは爆弾の見た目が読み込めない）。すでにあれば上書きしない -->
    <Target Name="CopyAssetBundleToUserData" AfterTargets="Build" Condition=" '$(DisableCopyToGame)' != 'True' And Exists('$(GameDirectory)') ">
        <Copy SourceFiles="Assets\farabomb.particle" DestinationFolder="$(GameDirectory)\UserData\FaraBombRush" SkipUnchangedFiles="true" Condition="!Exists('$(GameDirectory)\UserData\FaraBombRush\farabomb.particle')"/>
    </Target>
    <!-- .csproj.user の ReferencePath（1.29.1 などの固定パス）は csproj 本体より後に評価されて優先されてしまうため、
         参照を解決する直前に、検索パスを GameVersion のフォルダ（Managed / Libs / Plugins）に差し替える -->
    <Target Name="UseGameVersionReferencePath" BeforeTargets="ResolveAssemblyReferences">
        <PropertyGroup>
            <GameReferencePath>$(GameDirectory)\Beat Saber_Data\Managed\;$(GameDirectory)\Libs\;$(GameDirectory)\Plugins\</GameReferencePath>
            <ReferencePath>$(GameReferencePath)</ReferencePath>
            <!-- .NET Framework の BCL（mscorlib / System など）は、ゲームの Managed にある Unity 版より {TargetFrameworkDirectory} を優先する -->
            <AssemblySearchPaths>{CandidateAssemblyFiles};{HintPathFromItem};{TargetFrameworkDirectory};$(GameReferencePath);{RawFileName}</AssemblySearchPaths>
        </PropertyGroup>
    </Target>
    <!-- Plugins へのコピーは BeatSaberModdingTools.Tasks（BSMT_CopyToPlugins）が GameDirectory の Plugins に行う。
         以前はここで 1.29.1 と 1.40.8 の両方にコピーしていたため、1.29.1 用の DLL が 1.40.8 に入って起動エラーになった。
         コピーしたくないときは -p:DisableCopyToGame=True を付けてビルドする -->
</Project>